# Agent harness the spawned runner uses by default: `claude` for the real SDK,
# `codex` for the Codex CLI app-server, `fake` for the scripted adapter (lets the
# UI run without either installed). The sidebar can pick claude or codex per
# environment; `fake` hides the picker.
RUNNER_AGENT=fake

# Path to the Claude Code executable. Leave unset to resolve it from PATH.
# On Windows this must be claude.exe, not the .cmd shim.
# CLAUDE_BINARY=

# Path to the Codex executable. Leave unset to resolve it from PATH.
# On Windows the npm shim (codex.cmd) is fine; the adapter runs it through a shell.
# CODEX_BINARY=

# Model the codex adapter starts threads with. Leave unset for the CLI default.
# CODEX_MODEL=

# Where the Claude CLI keeps its credentials. Forwarded to every runner, so setting it
# gives the app its own login instead of sharing the machine's ~/.claude. The sidebar's
# Connect Claude card logs in there; an API key set in that card is stored by the runner
# and injected as ANTHROPIC_API_KEY per turn, so it does not belong in this file.
# CLAUDE_CONFIG_DIR=

# Where environments run: `local` spawns a runner on this machine per project (default);
# `daytona` creates a sandbox per project from the runner snapshot and opens repositories
# by URL. Public so the Add project dialog offers only the sources that work.
# NEXT_PUBLIC_ENV_PROVIDER=daytona

# Daytona settings, read when the provider above is `daytona`. The key needs write and
# delete on sandboxes; the snapshot is built from packages/runner/Dockerfile.
# DAYTONA_API_KEY=
# DAYTONA_SNAPSHOT=agent-console-runner:0.1.2

# Required in `daytona` mode, unused otherwise: the key that encrypts the session cookie
# each visitor's provider sign-ins live in. 32+ random bytes, base64 or hex
# (`openssl rand -base64 32`). Rotating it signs everyone out; it is not read locally.
# SESSION_SECRET=
