{
  "name": "@agent-console/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-root": {
      "types": "./dist/data-root.d.ts",
      "import": "./dist/data-root.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@agent-console/contracts": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
